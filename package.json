{
  "name": "@hamid-vakilzadeh/canvas-mcp",
  "version": "0.2.0",
  "description": "Run Canvas LMS tools locally as a stdio MCP server",
  "type": "module",
  "bin": {
    "canvas-mcp": "bin/canvas-mcp.js"
  },
  "files": [
    "bin/canvas-mcp.js",
    "src/**/*.py",
    "src/**/*.md",
    "src/reporting/ui/*.html",
    "src/reporting/ui/*.css",
    "src/reporting/ui/*.js",
    "REPORTING.md",
    "REPORTING_VALIDATION.md",
    "pyproject.toml",
    "uv.lock",
    ".python-version"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamid-vakilzadeh/CanvasMCP.git"
  },
  "scripts": {
    "test": "node --test tests/launcher.test.js",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "check:dashboard": "tsc --noEmit",
    "test:dashboard": "playwright test",
    "prepack": "npm run build:dashboard"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "canvas",
    "lms",
    "mcp",
    "stdio"
  ],
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
